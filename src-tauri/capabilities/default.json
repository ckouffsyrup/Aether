{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Base Aether window permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "global-shortcut:default",
    "autostart:default",
    "window-state:default",
    "core:window:allow-show",
    "core:window:allow-set-focus"
  ]
}