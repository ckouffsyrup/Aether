{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether",
  "version": "../package.json",
  "identifier": "studio.veyl.aether",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aether — Veyl Studios",
        "width": 1380,
        "height": 860,
        "minWidth": 950,
        "minHeight": 600,
        "backgroundColor": "#0b0b12",
        "visible": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/card-art/**",
          "$APPDATA/icon-cache/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}