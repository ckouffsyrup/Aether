{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether",
  "version": "../package.json",
  "identifier": "studio.veyl.aether",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aether — Veyl Studios",
        "width": 1380,
        "height": 860,
        "minWidth": 950,
        "minHeight": 600,
        "backgroundColor": "#0b0b12",
        "visible": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/card-art/**",
          "$APPDATA/icon-cache/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Veyl Studios",
    "copyright": "© 2026 Veyl Studios. All rights reserved.",
    "category": "Utility",
    "shortDescription": "Desktop hub for your apps, games, folders and websites",
    "longDescription": "Aether is a Windows desktop hub by Veyl Studios for launching your apps, games, folders and websites.",
    "homepage": "https://github.com/ckouffsyrup/Aether",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwMEVGQjQzRkFCMTM5RjMKUldUek9iSDZRL3NPY0VTUmxhZ2x2eml2RmExaWFSMVRXREZGWjVPMkw3OVZTNnVBRE1FbnRkcS8K",
      "endpoints": [
        "https://github.com/ckouffsyrup/Aether/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
